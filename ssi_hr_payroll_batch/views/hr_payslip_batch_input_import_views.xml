<odoo>
    <record id="hr_payslip_batch_input_import_view_form" model="ir.ui.view">
        <field name="name">hr.payslip_batch_input_import form</field>
        <field name="model">hr.payslip_batch_input_import</field>
        <field name="arch" type="xml">
            <form string="Import Payslip Batch Input">
                <group>
                    <field name="batch_id" invisible="1" />
                    <field name="data" filename="filename" />
                    <field name="filename" invisible="1" />
                </group>
                <div>
                    <p>
                        Upload the xlsx file exported from this payslip batch with the
                        manual input amounts filled in. Only payslips in Draft state
                        are updated; the header row must keep the original input codes.
                    </p>
                </div>
                <footer>
                    <button
                        name="action_import"
                        string="Import"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Discard" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="hr_payslip_batch_input_import_action" model="ir.actions.act_window">
        <field name="name">Import Input</field>
        <field name="res_model">hr.payslip_batch_input_import</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
