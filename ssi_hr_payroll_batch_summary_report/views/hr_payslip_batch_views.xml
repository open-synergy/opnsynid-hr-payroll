<odoo>

    <record id="hr_payslip_batch_view_form_salary_summary" model="ir.ui.view">
        <field name="name">hr.payslip.batch.form.salary.summary</field>
        <field name="model">hr.payslip_batch</field>
        <field
            name="inherit_id"
            ref="ssi_hr_payroll_batch.hr_payslip_batch_view_form"
        />
        <field name="arch" type="xml">
            <!-- Insert report buttons before the statusbar field -->
            <xpath expr="//header/field[@name='state']" position="before">
                <button
                    name="action_print_salary_summary"
                    string="Salary Summary"
                    type="object"
                    class="btn-secondary"
                    icon="fa-table"
                    attrs="{'invisible': [('state', '=', 'draft')]}"
                />
                <button
                    name="action_export_salary_summary_xlsx"
                    string="Export XLSX"
                    type="object"
                    class="btn-secondary"
                    icon="fa-file-excel-o"
                    attrs="{'invisible': [('state', '=', 'draft')]}"
                />
            </xpath>
        </field>
    </record>

</odoo>
